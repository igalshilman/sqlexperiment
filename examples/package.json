{
  "name": "sqlite-kv-examples",
  "version": "0.1.0",
  "private": true,
  "description": "Examples of SQL in Restate virtual objects with the TypeScript SDK: a ledger and a shop (node/), a durable pi agent (pi/), a LangGraph agent (langgraph/), a Claude agent on the Anthropic SDK's tool runner (claude/) and a DeepSeek Harness agent (deepseek/)",
  "type": "module",
  "scripts": {
    "serve": "node serve.ts",
    "test": "node test.ts",
    "test:concurrency": "node concurrency.ts",
    "test:pi": "vitest run pi",
    "test:langgraph": "vitest run langgraph",
    "test:claude": "vitest run claude",
    "test:deepseek": "vitest run deepseek",
    "typecheck": "tsc -p .",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "check": "tsc -p . && oxlint --type-aware && oxfmt --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-agent-loop": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-checkpoint-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@earendil-works/chord": "1.1.0",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-durable": "1.1.0",
    "@langchain/core": "1.2.12",
    "@langchain/langgraph": "1.4.18",
    "@langchain/langgraph-checkpoint": "1.1.5",
    "@restatedev/restate-sdk": "file:../vendor/typescript/.build/restatedev-restate-sdk-1.17.3.tgz",
    "sqlite-kv": "file:../sqlite-kv/node",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@langchain/langgraph-checkpoint-validation": "1.1.1",
    "@types/node": "22.20.5",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=22.18"
  }
}
