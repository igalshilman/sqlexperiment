+// The handler's context type follows `journalReplay`: checked by the compiler
+// (vitest --typecheck), not run.
+
+import { describe, expectTypeOf, it } from "vitest";
+import * as restate from "../src/index.js";
+import type {
+  Context,
+  InvocationId,
+  ObjectContext,
+  RestatePromise,
+  SqlContext,
+  SqlInvocationPromise,
+  SqlObjectContext,
+  SqlObjectSharedContext,
+  SqlWorkflowContext,
+} from "../src/index.js";
+
+const helper = restate.object({
+  name: "Helper",
+  handlers: {
+    slow: async (_ctx: restate.ObjectContext, ms: number) => ms * 2,
+  },
+});
+
+describe("the context without journal replay", () => {
+  it("is the handler's context when the service's options say so", () => {
+    restate.service({
+      name: "S",
+      handlers: {
+        h: async (ctx, input: number) => {
+          expectTypeOf(ctx).toEqualTypeOf<SqlContext>();
+          expectTypeOf(ctx.journalReplay).toEqualTypeOf<false>();
+          expectTypeOf(ctx.sleep(1)).toEqualTypeOf<Promise<void>>();
+          expectTypeOf(ctx.signal<string>("s")).toEqualTypeOf<
+            Promise<string>
+          >();
+          // @ts-expect-error: no RestatePromise methods
+          void ctx.sleep(1).map(() => 1);
+          // @ts-expect-error: awakeables need journal replay
+          ctx.awakeable();
+          // @ts-expect-error: no run; call the function directly
+          void ctx.run(() => 1);
+          await Promise.all([ctx.sleep(1), ctx.signal("s")]);
+          return input;
+        },
+      },
+      options: { journalReplay: false },
+    });
+  });
+
+  it("is not otherwise", () => {
+    restate.service({
+      name: "S",
+      handlers: {
+        h: async (ctx) => {
+          expectTypeOf(ctx).toEqualTypeOf<Context>();
+          expectTypeOf(ctx.sleep(1)).toEqualTypeOf<RestatePromise<void>>();
+          ctx.awakeable();
+        },
+      },
+    });
+    restate.service({
+      name: "S",
+      handlers: {
+        h: async (ctx) => {
+          expectTypeOf(ctx).toEqualTypeOf<Context>();
+        },
+      },
+      options: { journalReplay: true },
+    });
+    // A boolean that is not known to be false: journal replay.
+    const replay = Math.random() > 0.5;
+    restate.service({
+      name: "S",
+      handlers: {
+        h: async (ctx) => {
+          expectTypeOf(ctx).toEqualTypeOf<Context>();
+        },
+      },
+      options: { journalReplay: replay },
+    });
+  });
+
+  // An object's handlers annotate their context, as with journal replay (an
+  // exclusive and a shared one are both allowed); a mismatch is an error, below.
+  it("follows restate.sqlOptions, for exclusive and shared handlers", () => {
+    restate.object({
+      name: "O",
+      handlers: {
+        exclusive: async (ctx: SqlObjectContext) => {
+          expectTypeOf(ctx.get<number>("k")).toEqualTypeOf<
+            Promise<number | null>
+          >();
+          await ctx.db.query("SELECT 1");
+          expectTypeOf(ctx.db).toEqualTypeOf<restate.SqlSession>();
+          const n = await ctx.transaction(async ({ db, tx }) => {
+            expectTypeOf(db).toEqualTypeOf<restate.SqlDatabase>();
+            tx.objectSendClient<{
+              m: (ctx: unknown, n: number) => Promise<void>;
+            }>({ name: "O" }, "k").m(1);
+            return 1;
+          });
+          expectTypeOf(n).toEqualTypeOf<number>();
+        },
+        shared: restate.handlers.object.shared(
+          { journalReplay: false },
+          async (ctx) => {
+            expectTypeOf(ctx).toEqualTypeOf<SqlObjectSharedContext>();
+          }
+        ),
+        annotated: async (ctx: SqlObjectContext, key: string) => key,
+      },
+      options: { ...restate.sqlOptions },
+    });
+  });
+
+  it("has clients whose calls are plain promises with an invocation id", () => {
+    restate.service({
+      name: "S",
+      handlers: {
+        h: async (ctx) => {
+          const call = ctx.objectClient(helper, "k").slow(1);
+          expectTypeOf(call).toEqualTypeOf<SqlInvocationPromise<number>>();
+          expectTypeOf(call.invocationId).toEqualTypeOf<
+            Promise<InvocationId>
+          >();
+          // @ts-expect-error: no RestatePromise methods
+          void call.orTimeout(10);
+          const scoped = ctx.scope("s").objectClient(helper, "k").slow(1);
+          expectTypeOf(scoped).toEqualTypeOf<SqlInvocationPromise<number>>();
+          const send = ctx.objectSendClient(helper, "k").slow(1);
+          expectTypeOf(send.invocationId).toEqualTypeOf<
+            Promise<InvocationId>
+          >();
+          expectTypeOf(
+            ctx.invocation("inv1" as InvocationId).attach<number>()
+          ).toEqualTypeOf<Promise<number>>();
+        },
+      },
+      options: { journalReplay: false },
+    });
+  });
+
+  it("has a workflow's durable promises as plain promises", () => {
+    // Alone, `run` takes its context from the options.
+    restate.workflow({
+      name: "V",
+      handlers: {
+        run: async (ctx) => {
+          expectTypeOf(ctx).toEqualTypeOf<SqlWorkflowContext<any>>();
+        },
+      },
+      options: { journalReplay: false },
+    });
+    // With an annotated shared handler, annotated too (as with journal replay).
+    restate.workflow({
+      name: "W",
+      handlers: {
+        run: async (ctx: SqlWorkflowContext) => {
+          expectTypeOf(ctx.promise<string>("p").get()).toEqualTypeOf<
+            Promise<string>
+          >();
+          return await ctx.promise<string>("p");
+        },
+        approve: async (
+          ctx: restate.SqlWorkflowSharedContext,
+          value: string
+        ) => {
+          await ctx.promise<string>("p").resolve(value);
+        },
+      },
+      options: { journalReplay: false },
+    });
+  });
+
+  it("is not mixed up with the context with journal replay", () => {
+    restate.object({
+      name: "O",
+      handlers: {
+        // @ts-expect-error: the handler expects journal replay, the object has none
+        h: async (_ctx: ObjectContext) => {},
+      },
+      options: { ...restate.sqlOptions },
+    });
+    restate.object({
+      name: "O",
+      handlers: {
+        // @ts-expect-error: the handler expects no journal replay, the object replays
+        h: async (_ctx: SqlObjectContext) => {},
+      },
+    });
