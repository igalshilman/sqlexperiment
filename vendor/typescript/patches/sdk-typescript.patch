+import { describe, expect, it } from "vitest";
+import { AttemptEnd } from "../src/sql.js";
+
+const never = () => new Promise<never>(() => {});
+
+describe("AttemptEnd", () => {
+  it("passes a request's outcome through while the attempt runs", async () => {
+    const end = new AttemptEnd(never());
+    await expect(end.race(Promise.resolve(1))).resolves.toBe(1);
+    await expect(end.race(Promise.reject(new Error("no")))).rejects.toThrow(
+      "no"
+    );
+  });
+
+  it("rejects a request still waiting when the attempt ends", async () => {
+    const attempt = Promise.withResolvers<void>();
+    const end = new AttemptEnd(attempt.promise);
+    // A suspended attempt never answers this get.
+    const get = end.race(never());
+    attempt.reject(new Error("suspended"));
+    await expect(get).rejects.toThrow("suspended");
+    // And what is asked afterwards fails at once.
+    await expect(end.race(never())).rejects.toThrow("suspended");
+  });
+
+  it("calls a listener when the attempt ends, unless cancelled", async () => {
+    const attempt = Promise.withResolvers<void>();
+    const end = new AttemptEnd(attempt.promise);
+    const calls: string[] = [];
+    end.onEnd(() => calls.push("close"));
+    const cancel = end.onEnd(() => calls.push("cancelled"));
+    cancel();
+    attempt.reject(new Error("aborted"));
+    await expect(end.race(never())).rejects.toThrow("aborted");
+    expect(calls).toEqual(["close"]);
+    // A listener added after the end runs at once.
+    end.onEnd(() => calls.push("late"));
+    expect(calls).toEqual(["close", "late"]);
+  });
+});
