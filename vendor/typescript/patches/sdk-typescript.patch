+   */
+  async end<T>(outcome: Outcome<T>): Promise<T> {
+    this.#ended = true;
+    const session = this.#session;
+    if (session === undefined) return settle(outcome);
+    let db: Session;
+    try {
+      db = await session;
+    } catch {
+      // The open failed, and its error went to the call that made it.
+      return settle(outcome);
+    }
+    this.#cancel();
+    if ("error" in outcome) {
+      const error = this.#errors.classify(outcome.error, db.isUsable());
+      // The handler's error stands: its writes are stored in order before
+      // the result, whether or not the save confirms them for the cache.
+      await (db.isUsable() ? db.save() : db.close()).catch(() =>
+        db.close().catch(() => {})
+      );
+      throw error;
+    }
+    if (db.isUsable()) {
+      await db.save();
+    } else {
+      await db.close();
+    }
+    return outcome.value;
+  }
+}
+
+/**
+ * Run `handler`, then end the attempt's SQL session, if it opened one
+ * (see {@link SqlAttempt.end}). @internal
+ */
+export async function withSql<T>(
+  handler: () => Promise<T>,
+  attempt: () => SqlAttempt | undefined
+): Promise<T> {
+  let outcome: Outcome<T>;
+  try {
+    outcome = { value: await handler() };
+  } catch (error) {
+    outcome = { error };
+  }
+  const sql = attempt();
+  return sql === undefined ? settle(outcome) : sql.end(outcome);
+}
