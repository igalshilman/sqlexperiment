+// The context of a handler without journal replay (`journalReplay: false`).
+//
+// It is the handler's context, except that what would be a RestatePromise is a
+// plain JS promise, so user code awaits and combines it as it likes:
+// Promise.all, Promise.race, its own combinators, or a library's. Each promise
+// is registered, when the operation is made, with the invocation's selector,
+// which drives all of them from one await point (see promise_selector.ts). So
+// an operation starts when it is made, whether or not it is awaited; and
+// RestatePromise combinators and methods (`map`, `orTimeout`) are not
+// available, nor needed. Nor is `ctx.run`: with nothing replayed its result is
+// not kept, and a retried attempt calls the function again anyway.
+
+import { isRestatePromise, plainPromise } from "./promises.js";
+import { TerminalError } from "./types/errors.js";
+
+// `ctx.run`, refused: a terminal error, since a retry would fail the same way.
+function refusedRun(): never {
+  throw new TerminalError(
+    "ctx.run is not available without journal replay: call the function directly"
+  );
+}
+
+// Methods whose result is an object of more operations (a client, a scoped
+// context, an invocation reference, a workflow's durable promise), wrapped the
+// same way.
+const WRAP_RESULT = new Set([
+  "serviceClient",
+  "objectClient",
+  "workflowClient",
+  "serviceSendClient",
+  "objectSendClient",
+  "workflowSendClient",
+  "client",
+  "sendClient",
+  "scope",
+  "invocation",
+  "signal",
+  "promise",
+]);
+// Properties that are objects of more operations.
+const WRAP_PROPERTY = new Set(["date"]);
+
+function convert(value: any): any {
+  if (value === null || typeof value !== "object") return value;
+  if (isRestatePromise(value)) {
+    const promise: any = plainPromise(value);
+    // A call: its invocation id, when asked for.
+    if ("invocationId" in value) {
+      return withInvocationId(promise, value);
+    }
+    return promise;
+  }
+  // A send: only its invocation id.
+  if (
+    "invocationId" in value &&
+    isRestatePromise(value.invocationId as Promise<unknown>)
+  ) {
+    return withInvocationId({}, value);
+  }
+  // An awakeable (refused without journal replay, but converted all the same).
+  if ("id" in value && "promise" in value && isRestatePromise(value.promise)) {
+    return { id: value.id, promise: plainPromise(value.promise) };
+  }
+  return value;
+}
+
+function withInvocationId<T extends object>(target: T, handle: any): T {
+  let invocationId: Promise<string> | undefined;
+  return Object.defineProperty(target, "invocationId", {
+    get: () => (invocationId ??= plainPromise(handle.invocationId)),
+    enumerable: true,
+  });
+}
+
+// Every method's result converted, and the listed ones wrapped. Methods run
+// on the target itself, so a wrapped context behaves as the context.
+function wrap<T extends object>(target: T, wrapAll: boolean): T {
+  return new Proxy(target, {
+    get(t, prop, receiver) {
+      if (!wrapAll && prop === "run") return refusedRun;
+      const value = Reflect.get(t, prop, t);
+      if (typeof prop !== "string") return value;
+      if (typeof value === "function") {
+        return (...args: unknown[]) => {
+          const result = value.apply(t, args);
+          if (
+            (wrapAll || WRAP_RESULT.has(prop)) &&
+            result !== null &&
+            typeof result === "object" &&
+            !isRestatePromise(result) &&
+            !("invocationId" in result)
+          ) {
+            return wrap(result, true);
+          }
+          return convert(result);
+        };
+      }
+      if (
+        WRAP_PROPERTY.has(prop) &&
+        value !== null &&
+        typeof value === "object"
+      ) {
+        return wrap(value, true);
+      }
+      void receiver;
+      return value;
+    },
+  });
+}
+
+/** The context handed to a handler without journal replay. */
+export function sqlContext<T extends object>(ctx: T): T {
+  return wrap(ctx, false);
+}
