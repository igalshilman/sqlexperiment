diff --git a/packages/libs/restate-sdk/test/sql_errors.test.ts b/packages/libs/restate-sdk/test/sql_errors.test.ts
new file mode 100644
index 0000000..2d9b44c
--- /dev/null
+++ b/packages/libs/restate-sdk/test/sql_errors.test.ts
@@ -0,0 +1,107 @@
+/*
+ * Copyright (c) 2023-2024 - Restate Software, Inc., Restate GmbH
+ *
+ * This file is part of the Restate SDK for Node.js/TypeScript,
+ * which is released under the MIT license.
+ *
+ * You can find a copy of the license in file LICENSE in the root
+ * directory of this repository or package, or at
+ * https://github.com/restatedev/sdk-typescript/blob/main/LICENSE
+ */
+
+import { describe, expect, it } from "vitest";
+import { SqlErrors, type SqlDatabase } from "../src/sql.js";
+import { TerminalError } from "../src/types/errors.js";
+
+/** A database whose statements fail with `error` when they contain "bad". */
+function fakeSession(commitError?: Error) {
+  const db: SqlDatabase = {
+    query: (sql) =>
+      sql.includes("bad")
+        ? Promise.reject(new Error("no such table: bad"))
+        : Promise.resolve([]),
+    queryColumns: () => Promise.resolve({ columns: [], rows: [] }),
+    execute: (sql) =>
+      sql.includes("bad")
+        ? Promise.reject(new Error("no such table: bad"))
+        : Promise.resolve(),
+  };
+  return {
+    ...db,
+    async transaction<T>(body: (tx: SqlDatabase) => Promise<T>): Promise<T> {
+      const result = await body(db);
+      if (commitError) throw commitError;
+      return result;
+    },
+    isUsable: () => true,
+    save: () => Promise.resolve(),
+  };
+}
+
+async function failure(promise: Promise<unknown>): Promise<unknown> {
+  return promise.then(
+    () => expect.unreachable(),
+    (error: unknown) => error
+  );
+}
+
+describe("SqlErrors", () => {
+  it("makes an SQL error terminal", async () => {
+    const errors = new SqlErrors();
+    const db = errors.view(fakeSession());
+    const error = await failure(db.execute("SELECT * FROM bad"));
+    const classified = errors.classify(error, true);
+    expect(classified).toBeInstanceOf(TerminalError);
+    expect((classified as Error).message).toBe("no such table: bad");
+  });
+
+  it("makes an SQL error terminal when the body rethrows it", async () => {
+    const errors = new SqlErrors();
+    const session = fakeSession();
+    const error = await failure(
+      errors.transaction(session, async (tx) => {
+        try {
+          await tx.execute("bad");
+        } catch (e) {
+          throw e;
+        }
+      })
+    );
+    expect(errors.classify(error, true)).toBeInstanceOf(TerminalError);
+  });
+
+  it("retries the body's own error, such as a failed request", async () => {
+    const errors = new SqlErrors();
+    const own = new Error("529 overloaded");
+    const error = await failure(
+      errors.transaction(fakeSession(), async (tx) => {
+        await tx.execute("INSERT INTO t VALUES(1)");
+        throw own;
+      })
+    );
+    expect(errors.classify(error, true)).toBe(own);
+  });
+
+  it("keeps the body's TerminalError", async () => {
+    const errors = new SqlErrors();
+    const own = new TerminalError("rejected");
+    expect(errors.classify(own, true)).toBe(own);
+  });
+
+  it("makes a failed COMMIT terminal", async () => {
+    const errors = new SqlErrors();
+    const commit = new Error("FOREIGN KEY constraint failed");
+    const error = await failure(
+      errors.transaction(fakeSession(commit), async () => {})
+    );
+    expect(errors.classify(error, true)).toBeInstanceOf(TerminalError);
+  });
+
+  it("retries an error once the session has ended (a storage error)", async () => {
+    const errors = new SqlErrors();
+    const error = await failure(
+      errors.view(fakeSession()).execute("SELECT * FROM bad")
+    );
+    expect(errors.classify(error, false)).toBe(error);
+  });
+});
