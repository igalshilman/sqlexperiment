diff --git a/src/endpoint/futures/ephemeral_poll.rs b/src/endpoint/futures/ephemeral_poll.rs
new file mode 100644
index 0000000..82b835e
--- /dev/null
+++ b/src/endpoint/futures/ephemeral_poll.rs
@@ -0,0 +1,94 @@
+use crate::endpoint::ErrorInner;
+use crate::endpoint::context::ContextInternalInner;
+use restate_sdk_shared_core::{EphemeralCompletionId, Error as CoreError, VM, Value};
+use std::future::Future;
+use std::pin::Pin;
+use std::sync::{Arc, Mutex};
+use std::task::Poll;
+
+/// The value of an ephemeral command: answered by the VM at once (state it
+/// knows), or by a notification the runtime sends, which this future reads
+/// or another one does (keeping it, if its `do_await` reported it).
+pub(crate) struct EphemeralGetFuture {
+    ctx: Arc<Mutex<ContextInternalInner>>,
+    id: EphemeralCompletionId,
+    flushed: bool,
+}
+
+impl EphemeralGetFuture {
+    pub fn new(ctx: Arc<Mutex<ContextInternalInner>>, id: EphemeralCompletionId) -> Self {
+        Self {
+            ctx,
+            id,
+            flushed: false,
+        }
+    }
+}
+
+macro_rules! must_lock {
+    ($mutex:expr) => {
+        $mutex.try_lock().expect("You're trying to await two futures at the same time and/or trying to perform some operation on the restate context while awaiting a future. This is not supported!")
+    };
+}
+
+impl Future for EphemeralGetFuture {
+    type Output = Result<Value, ErrorInner>;
+
+    fn poll(mut self: Pin<&mut Self>, cx: &mut std::task::Context<'_>) -> Poll<Self::Output> {
+        let id = self.id;
+        let ctx = Arc::clone(&self.ctx);
+        let mut inner_lock = must_lock!(ctx);
+        if !self.flushed {
+            // The command goes to the runtime before anything waits on it.
+            let b = inner_lock.vm.take_output();
+            if !b.is_empty() && !inner_lock.write.send(b) {
+                return Poll::Ready(Err(ErrorInner::Suspended));
+            }
+            self.flushed = true;
+        }
+        loop {
+            // Kept by another future's await, or ready in the VM: input is
+            // applied to it as it is read.
+            if let Some(value) = inner_lock.ephemeral.remove(&id) {
+                return Poll::Ready(Ok(value));
+            }
+            match inner_lock.vm.take_ephemeral_notification(id) {
+                Ok(Some(value)) => return Poll::Ready(Ok(value)),
+                Ok(None) => {}
+                Err(e) => return Poll::Ready(Err(e.into())),
+            }
+            // Not yet: read input, as the futures awaiting handles do.
+            let read_result = match inner_lock.read.poll_recv(cx) {
+                Poll::Ready(t) => t,
+                Poll::Pending => {
+                    inner_lock.wait_input(cx.waker());
+                    return Poll::Pending;
+                }
+            };
+            match read_result {
+                Some(Ok(b)) => inner_lock.vm.notify_input(b),
+                Some(Err(e)) => inner_lock.vm.notify_error(
+                    CoreError::new(500u16, format!("Error when reading the body {e:?}",)),
+                    None,
+                ),
+                None => {
+                    // The notification can't arrive any more: retry the attempt.
+                    inner_lock.vm.notify_input_closed();
+                    if let Some(value) = inner_lock.ephemeral.remove(&id) {
+                        return Poll::Ready(Ok(value));
+                    }
+                    if let Ok(Some(value)) = inner_lock.vm.take_ephemeral_notification(id) {
+                        return Poll::Ready(Ok(value));
+                    }
+                    return Poll::Ready(Err(CoreError::new(
+                        500u16,
+                        "The input closed while an ephemeral state get was in flight",
+                    )
+                    .into()));
+                }
+            }
+            let waiters = inner_lock.take_input_waiters();
+            waiters.into_iter().for_each(std::task::Waker::wake);
+        }
+    }
+}
