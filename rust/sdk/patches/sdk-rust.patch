+/// An object's state as bytes, for this invocation: see [`ObjectContext::raw_state`].
+/// Its writes are the invocation's, in the order they are made; its reads see
+/// the stored state and this invocation's own writes. For a handler that
+/// replays nothing.
+#[derive(Clone)]
+pub struct RawState(ContextInternal);
+
+impl RawState {
+    /// The value of `key`, if set: read without a journal entry where the
+    /// server speaks protocol v8 (its ephemeral get), as nothing reads the
+    /// journal back; a journaled get on v7.
+    pub fn get<'a>(
+        &'a self,
+        key: &'a str,
+    ) -> impl Future<Output = Result<Option<bytes::Bytes>, TerminalError>> + Send + 'a {
+        // TODO: drop the journaled get once a Restate release ships v8
+        // (FUTURE.md at the repository's root): 1.8 negotiates v7 at most.
+        match self.0.has_ephemeral_get() {
+            true => futures::future::Either::Left(self.0.get_ephemeral(key)),
+            false => futures::future::Either::Right(self.0.get(key)),
+        }
+    }
+
+    /// Set `key` to `value`.
+    pub fn set(&self, key: &str, value: bytes::Bytes) {
+        self.0.set(key, value)
+    }
+
+    /// Clear `key`.
+    pub fn clear(&self, key: &str) {
+        self.0.clear(key)
+    }
+
+    /// Every key set, this invocation's writes included: a journaled read
+    /// of the object's keys.
+    pub fn keys(&self) -> impl Future<Output = Result<Vec<String>, TerminalError>> + Send + '_ {
+        self.0.get_keys()
+    }
+
+    /// Wait until the writes made so far are stored: an empty `ctx.run`,
+    /// acknowledged after the commands before it. Writes return at once, and
+    /// the runtime stores them in order.
+    pub fn sync(&self) -> impl Future<Output = Result<(), TerminalError>> + Send + '_ {
+        self.0.run(|| async { Ok(()) })
+    }
 }
 
