+/// An object's state as bytes, for this invocation: see [`ObjectContext::raw_state`].
+/// Its reads and writes are the invocation's, in the order they are made.
+#[derive(Clone)]
+pub struct RawState(ContextInternal);
+
+impl RawState {
+    /// The value of `key`, if set.
+    pub fn get<'a>(
+        &'a self,
+        key: &'a str,
+    ) -> impl Future<Output = Result<Option<bytes::Bytes>, TerminalError>> + Send + 'a {
+        self.0.get(key)
+    }
+
+    /// Set `key` to `value`.
+    pub fn set(&self, key: &str, value: bytes::Bytes) {
+        self.0.set(key, value)
+    }
+
+    /// Clear `key`.
+    pub fn clear(&self, key: &str) {
+        self.0.clear(key)
+    }
+
+    /// Wait until the writes made so far are stored: an empty `ctx.run`,
+    /// acknowledged after the commands before it. Writes return at once, and
+    /// the runtime stores them in order.
+    pub fn sync(&self) -> impl Future<Output = Result<(), TerminalError>> + Send + '_ {
+        self.0.run(|| async { Ok(()) })
+    }
 }
 
