+
+/// Whether a service's handlers replay their journal: the service's
+/// [`ServiceOptions::journal_replay`], and its handlers' own.
+#[derive(Default, Debug, Clone)]
+pub(crate) struct JournalReplay {
+    service: Option<bool>,
+    handlers: HashMap<String, bool>,
+}
+
+impl JournalReplay {
+    pub(crate) fn apply(&mut self, options: &ServiceOptions) {
+        if let Some(v) = options.journal_replay {
+            self.service = Some(v);
+        }
+        for (name, handler) in &options.handler_options {
+            if let Some(v) = handler.journal_replay {
+                self.handlers.insert(name.clone(), v);
+            }
+        }
+    }
+
+    pub(crate) fn enabled(&self, handler: &str) -> bool {
+        self.handlers
+            .get(handler)
+            .copied()
+            .or(self.service)
+            .unwrap_or(true)
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn a_handler_replays_unless_it_or_its_service_says_not_to() {
+        let mut replay = JournalReplay::default();
+        assert!(replay.enabled("run"));
+        replay.apply(
+            &ServiceOptions::new()
+                .journal_replay(false)
+                .handler("read", HandlerOptions::new().journal_replay(true)),
+        );
+        assert!(!replay.enabled("run"));
+        assert!(replay.enabled("read"));
+    }
+}
