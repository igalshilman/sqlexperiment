{
  // The package as published (pnpm pack): src/ compiled to JavaScript in
  // dist/, with its types, each module a file of its own. `pnpm build:ts`.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src"],
  "exclude": []
}
