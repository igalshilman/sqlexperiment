{
  // Type checking only: Node runs the .ts files directly (type stripping), and
  // vitest runs the tests. `pnpm typecheck`.
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    "types": ["node"],
    "noEmit": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    // What Node's type stripping runs: no enums, namespaces or parameter
    // properties; type-only imports marked as such; .ts in relative imports.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["**/node_modules", "packages/sdk-typescript/.build", "target"]
}
