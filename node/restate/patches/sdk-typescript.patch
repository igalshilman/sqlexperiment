+/*
+ * Copyright (c) 2023-2024 - Restate Software, Inc., Restate GmbH
+ *
+ * This file is part of the Restate SDK for Node.js/TypeScript,
+ * which is released under the MIT license.
+ *
+ * You can find a copy of the license in file LICENSE in the root
+ * directory of this repository or package, or at
+ * https://github.com/restatedev/sdk-typescript/blob/main/LICENSE
+ */
+
+// Without journal replay, a retried attempt runs the handler again from the
+// start, and each call or send it makes is a new command. So that it reaches
+// the invocation the earlier attempt started instead of starting another, a
+// call or send without an idempotency key gets one derived from this
+// invocation and the request: the same request, made the same number of times
+// before, gets the same key. Restate then attaches a repeated call to the
+// earlier invocation (and its result), and drops a repeated send.
+
+const encoder = new TextEncoder();
+
+/** A 64-bit FNV-1a hash of `parts`, in hex: two 32-bit lanes. */
+function hash(parts: (string | Uint8Array)[]): string {
+  let a = 0x811c9dc5;
+  let b = 0x050c5d1f;
+  const mix = (byte: number) => {
+    a = Math.imul(a ^ byte, 0x01000193);
+    b = Math.imul(b ^ byte, 0x01000193) ^ (a >>> 15);
+  };
+  for (const part of parts) {
+    const bytes = typeof part === "string" ? encoder.encode(part) : part;
+    for (const byte of bytes) mix(byte);
+    mix(0xff); // separator
+    mix(bytes.length & 0xff);
+  }
+  const hex = (n: number) => (n >>> 0).toString(16).padStart(8, "0");
+  return hex(a) + hex(b);
+}
+
+/** Idempotency keys for the calls and sends of one attempt. */
+export class IdempotencyKeys {
+  private readonly seen = new Map<string, number>();
+
+  constructor(private readonly invocationId: string) {}
+
+  /** The key of a request: `kind` ("call" or "send") and its target, input and delay. */
+  next(
+    kind: "call" | "send",
+    service: string,
+    method: string,
+    key: string | undefined,
+    parameter: Uint8Array,
+    delay?: number
+  ): string {
+    const digest = hash([
+      kind,
+      service,
+      method,
+      key ?? "",
+      parameter,
+      delay === undefined ? "" : String(delay),
+    ]);
+    const n = this.seen.get(digest) ?? 0;
+    this.seen.set(digest, n + 1);
+    return `${this.invocationId}:${digest}:${n}`;
+  }
+}
