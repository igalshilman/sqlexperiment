--- /dev/null
+++ b/packages/libs/restate-sdk/src/sql.ts
@@ -0,0 +1,198 @@
+/*
+ * Copyright (c) 2023-2024 - Restate Software, Inc., Restate GmbH
+ *
+ * This file is part of the Restate SDK for Node.js/TypeScript,
+ * which is released under the MIT license.
+ *
+ * You can find a copy of the license in file LICENSE in the root
+ * directory of this repository or package, or at
+ * https://github.com/restatedev/sdk-typescript/blob/main/LICENSE
+ */
+
+// SQL in a virtual object: `ctx.sql(body)` runs `body` against a database kept
+// in the object's state, through the sqlite-kv addon, with no journal replay.
+
+import { serde } from "@restatedev/restate-sdk-core";
+import { RestatePromise } from "./context.js";
+import type { ContextImpl } from "./context_impl.js";
+import { TerminalError } from "./types/errors.js";
+import { HandlerKind } from "./types/rpc.js";
+
+/** An SQL value. Integers come back as numbers, or as bigints beyond 2^53. */
+export type SqlValue = null | number | bigint | string | Uint8Array | boolean;
+
+/** The object's database, inside `ctx.sql`. */
+export interface SqlDatabase {
+  /** Run SQL and return its rows; parameters bind to a single statement. */
+  query(sql: string, params?: SqlValue[]): Promise<SqlValue[][]>;
+  /** Run SQL (one or more statements), discarding rows. */
+  execute(sql: string, params?: SqlValue[]): Promise<void>;
+}
+
+/**
+ * Options for an object whose handlers use `ctx.sql`: no journal replay, since
+ * a later attempt makes different reads; lazy state, so an invocation does not
+ * start by loading every page; and no journal kept after an invocation
+ * completes, since it holds every page it read.
+ *
+ * @experimental
+ */
+export const sqlOptions = {
+  journalReplay: false,
+  enableLazyState: true,
+  journalRetention: 0,
+} as const;
+
+/** An ordered store, as the sqlite-kv addon takes it. */
+export interface SqlStore {
+  get(key: string): Promise<Uint8Array | null | undefined>;
+  set(key: string, value: Uint8Array): void;
+  clear(key: string): void;
+  sync(): Promise<void>;
+}
+
+type Wrap = (store: SqlStore) => SqlStore;
+let wrapStore: Wrap | undefined;
+
+/** Wrap each object's store, such as for fault injection in tests. @internal */
+export function setSqlStoreWrapper(wrap: Wrap) {
+  wrapStore = wrap;
+}
+
+interface Session {
+  query(sql: string, params?: SqlValue[]): Promise<SqlValue[][]>;
+  execute(sql: string, params?: SqlValue[]): Promise<void>;
+  transaction<T>(body: (db: Session) => Promise<T>): Promise<T>;
+  isUsable(): boolean;
+  save(): Promise<void>;
+}
+
+type Addon = {
+  open: (namespace: string, store: SqlStore) => Promise<Session>;
+};
+
+// A variable, so that neither the bundler nor tsc resolves the optional addon.
+const ADDON = "sqlite-kv";
+let addon: Promise<Addon> | undefined;
+
+function loadAddon() {
+  addon ??= (import(ADDON) as Promise<Addon & { default?: Addon }>).then(
+    (m) => m.default ?? m,
+    (error) => {
+      addon = undefined;
+      throw new TerminalError(
+        `ctx.sql needs the sqlite-kv addon installed: ${String(error)}`
+      );
+    }
+  );
+  return addon;
+}
+
+/**
+ * The object's state as an ordered store: `set` and `clear` are state writes,
+ * which return at once and which the runtime stores in order; `sync` is an
+ * empty `ctx.run`, acknowledged after the commands before it.
+ *
+ * The context waits on one thing at a time, and the engine reads pages
+ * concurrently. So each request is issued at once, which keeps the commands in
+ * the engine's order, and the requests issued together are awaited as one
+ * batch, one batch after another.
+ */
+function objectStore(ctx: ContextImpl): SqlStore {
+  type Waiting = {
+    promise: RestatePromise<unknown>;
+    resolve: (value: unknown) => void;
+    reject: (reason: unknown) => void;
+  };
+  const waiting: Waiting[] = [];
+  let draining = false;
+  const later = (f: () => void) =>
+    typeof setImmediate === "function" ? setImmediate(f) : setTimeout(f, 0);
+  const drain = async () => {
+    while (waiting.length > 0) {
+      const batch = waiting.splice(0);
+      const results = await RestatePromise.allSettled(
+        batch.map((w) => w.promise)
+      );
+      results.forEach((result, i) =>
+        result.status === "fulfilled"
+          ? batch[i]!.resolve(result.value)
+          : batch[i]!.reject(result.reason)
+      );
+    }
+    draining = false;
+  };
+  const wait = <T>(promise: RestatePromise<T>) =>
+    new Promise<T>((resolve, reject) => {
+      waiting.push({
+        promise,
+        resolve: resolve as (value: unknown) => void,
+        reject,
+      });
+      if (!draining) {
+        draining = true;
+        later(() => void drain());
+      }
+    });
+  return {
+    get: (key) => wait(ctx.get(key, serde.binary)),
+    set: (key, value) => ctx.set(key, value, serde.binary),
+    clear: (key) => ctx.clear(key),
+    sync: () => wait(ctx.run("sync", () => {})),
+  };
+}
+
+/** `ctx.sql(body)`; see `ObjectContext.sql`. */
+export async function runSql<T>(
+  ctx: ContextImpl,
+  journalReplay: boolean,
+  body: (db: SqlDatabase) => Promise<T>
+): Promise<T> {
+  if (ctx.handlerKind !== HandlerKind.EXCLUSIVE) {
+    throw new TerminalError("ctx.sql is for exclusive object handlers");
+  }
+  if (journalReplay) {
+    throw new TerminalError(
+      "ctx.sql needs the object's options to include restate.sqlOptions: " +
+        "a replayed journal would not match the reads of a later attempt"
+    );
+  }
+  const sqliteKv = await loadAddon();
+  const namespace = `${ctx.request().target.service}/${ctx.key}`;
+  const store = objectStore(ctx);
+  const db = await sqliteKv.open(
+    namespace,
+    wrapStore ? wrapStore(store) : store
+  );
+  let result: { value: T } | { error: unknown };
+  try {
+    result = {
+      value: await db.transaction((tx) =>
+        body({
+          query: (sql, params) => tx.query(sql, params),
+          execute: (sql, params) => tx.execute(sql, params),
+        })
+      ),
+    };
+  } catch (error) {
+    // While the session is usable this was an SQL error, or the body's own,
+    // which a retry would repeat; a storage error ends the session, and the
+    // handler is retried.
+    result = {
+      error:
+        db.isUsable() && !(error instanceof TerminalError)
+          ? new TerminalError(
+              error instanceof Error ? error.message : String(error)
+            )
+          : error,
+    };
+  }
+  // Saving confirms the session's writes (an empty ctx.run, if it wrote), so
+  // that the page cache may trust them. A session that does not get here
+  // makes the next one in this process start cold.
+  if (db.isUsable()) {
+    await db.save();
+  }
+  if ("error" in result) throw result.error;
+  return result.value;
+}
