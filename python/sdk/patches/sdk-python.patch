+            Some(Value::Failure(f)) => Ok(Bound::new(py, PyFailure::from(f))?.into_any()),
+            Some(other) => Err(PyVMError::from(Error::new(
+                restate_sdk_shared_core::error::codes::INTERNAL,
+                format!("unexpected value of an ephemeral state get: {other:?}"),
+            )))?,
+        }
+    }
+
