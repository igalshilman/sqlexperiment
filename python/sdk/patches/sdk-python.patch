+#  directory of this repository or package, or at
+#  https://github.com/restatedev/sdk-typescript/blob/main/LICENSE
+#
+"""The journal_replay option: a service's default, and a handler's own."""
+
+from restate import Context, ObjectContext, Service, VirtualObject, Workflow, WorkflowContext
+from restate.vm import VMWrapper
+
+
+def test_handlers_replay_their_journal_by_default():
+    greeter = Service("greeter")
+
+    @greeter.handler()
+    async def greet(ctx: Context, name: str) -> str:
+        return name
+
+    assert greeter.handlers["greet"].journal_replay
+
+
+def test_a_service_sets_it_for_its_handlers_and_a_handler_overrides_it():
+    counter = VirtualObject("counter", journal_replay=False)
+
+    @counter.handler()
+    async def add(ctx: ObjectContext, n: int) -> None:
+        pass
+
+    @counter.handler(journal_replay=True)
+    async def replayed(ctx: ObjectContext) -> None:
+        pass
+
+    assert not counter.handlers["add"].journal_replay
+    assert counter.handlers["replayed"].journal_replay
+
+    flow = Workflow("flow")
+
+    @flow.main(journal_replay=False)
+    async def run(ctx: WorkflowContext) -> None:
+        pass
+
+    @flow.handler()
+    async def query(ctx: WorkflowContext) -> None:
+        pass
+
+    assert not flow.handlers["run"].journal_replay
+    assert flow.handlers["query"].journal_replay
+
+
+def test_the_vm_takes_it():
+    headers = [("content-type", "application/vnd.restate.invocation.v6")]
+    VMWrapper(headers, journal_replay=False)
+    VMWrapper(headers)
diff --git a/tests/selector.py b/tests/selector.py
new file mode 100644
index 0000000..7f2296c
--- /dev/null
+++ b/tests/selector.py
@@ -0,0 +1,283 @@
+#
+#  Copyright (c) 2023-2025 - Restate Software, Inc., Restate GmbH
+#
+#  This file is part of the Restate SDK for Python,
+#  which is released under the MIT license.
+#
+#  You can find a copy of the license in file LICENSE in the root
+#  directory of this repository or package, or at
+#  https://github.com/restatedev/sdk-typescript/blob/main/LICENSE
+#
+"""The selector of an invocation without journal replay, against a fake VM."""
+
+import asyncio
+from typing import Any, Dict, List, Set
+
+import pytest
+
+from restate.exceptions import SdkInternalException, SuspendedException, TerminalError
+from restate.selector import FutureSelector, is_ready
+from restate.vm import (
+    AllCompletedUnresolvedFuture,
+    DoProgressAnyCompleted,
+    DoProgressCancelSignalReceived,
+    DoProgressEphemeralNotificationReady,
+    DoProgressExecuteRun,
+    DoProgressWaitExternalProgress,
+    FirstCompletedUnresolvedFuture,
+    SingleUnresolvedFuture,
+    Suspended,
+    UnresolvedFuture,
+)
+
+
+@pytest.fixture(scope="session")
+def anyio_backend():
+    return "asyncio"
+
+
+pytestmark = [pytest.mark.anyio]
+
+
+class Disconnected(Exception):
+    pass
+
+
+class FakeVm:
+    """
+    A VM whose handles complete as input names them: a body chunk b"3" completes
+    handle 3, and b"e3" the ephemeral command 3 (reported ahead of the rest).
+    """
+
+    def __init__(self) -> None:
+        self.completed: Set[int] = set()
+        self.input: asyncio.Queue[Dict[str, Any]] = asyncio.Queue()
+        self.checks: List[UnresolvedFuture] = []
+        # Responses that do_progress gives before looking at the handles.
+        self.script: List[Any] = []
+        self.runs: List[int] = []
+        self.wakes = 0
+        self.ended = 0
+        self.tasks: List[asyncio.Future] = []
+        self.ephemeral: Dict[int, Any] = {}
+        self.ephemeral_ready: List[int] = []
+
+    def do_progress(self, future: UnresolvedFuture) -> Any:
+        self.checks.append(future)
+        if self.ephemeral_ready:
+            return DoProgressEphemeralNotificationReady(self.ephemeral_ready.pop(0))
+        if self.script:
+            return self.script.pop(0)
+        if is_ready(future, self.is_completed):
+            return DoProgressAnyCompleted()
+        return DoProgressWaitExternalProgress()
+
+    def is_completed(self, handle: int) -> bool:
+        return handle in self.completed
+
+    def take_ephemeral(self, completion_id: int) -> Any:
+        return self.ephemeral.pop(completion_id)
+
+    async def flush_output(self) -> None:
+        pass
+
+    async def receive(self) -> Dict[str, Any]:
+        return await self.input.get()
+
+    def wake(self) -> None:
+        self.wakes += 1
+        self.input.put_nowait({"type": "restate.wake"})
+
+    def execute_run(self, handle: int) -> None:
+        self.runs.append(handle)
+        self.completed.add(handle)
+        self.input.put_nowait({"type": "restate.run_completed"})
+
+    def notify_input(self, chunk: Dict[str, Any]) -> None:
+        body = chunk["body"]
+        if body.startswith(b"e"):
+            self.ephemeral_ready.append(int(body[1:]))
+        else:
+            self.completed.add(int(body))
+
+    def track(self, task: asyncio.Future) -> None:
+        self.tasks.append(task)
+
+    def on_end(self) -> None:
+        self.ended += 1
+
+    def complete(self, handle: int) -> None:
+        self.input.put_nowait({"type": "http.request", "body": str(handle).encode(), "more_body": True})
+
+    def complete_ephemeral(self, completion_id: int, value: Any) -> None:
+        self.ephemeral[completion_id] = value
+        self.input.put_nowait({"type": "http.request", "body": f"e{completion_id}".encode(), "more_body": True})
+
+
+def single(handle: int) -> SingleUnresolvedFuture:
+    return SingleUnresolvedFuture(handle)
+
+
+async def settle() -> None:
+    for _ in range(5):
+        await asyncio.sleep(0)
+
+
+async def test_a_ready_future_needs_no_loop():
+    vm = FakeVm()
+    vm.completed.add(1)
+    selector = FutureSelector(vm, Disconnected)
+    await selector.wait(single(1))
+    assert vm.checks == []
+
+
+async def test_an_ephemeral_command_keeps_the_loop_going_with_no_future():
+    vm = FakeVm()
+    selector = FutureSelector(vm, Disconnected)
+    value = asyncio.ensure_future(selector.wait_ephemeral(7))
+    await settle()
+    assert vm.checks == [FirstCompletedUnresolvedFuture([])]
+    vm.complete_ephemeral(7, b"v")
+    assert await value == b"v"
+    await settle()
+    assert selector.size == 0
+    assert vm.tasks[0].done()
+
+
+async def test_an_ephemeral_command_completes_alongside_the_waits():
+    vm = FakeVm()
+    selector = FutureSelector(vm, Disconnected)
+    wait = asyncio.ensure_future(selector.wait(single(1)))
+    value = asyncio.ensure_future(selector.wait_ephemeral(2))
+    await settle()
+    vm.complete_ephemeral(2, None)
+    assert await value is None
+    assert not wait.done()
+    vm.complete(1)
+    await wait
+    assert selector.size == 0
+
+
+async def test_the_end_of_the_attempt_fails_an_ephemeral_command():
+    vm = FakeVm()
+    selector = FutureSelector(vm, Disconnected)
+    value = asyncio.ensure_future(selector.wait_ephemeral(1))
+    await settle()
+    vm.input.put_nowait({"type": "http.disconnect"})
+    with pytest.raises(Disconnected):
+        await value
+
+
+async def test_concurrent_waits_share_one_await_point():
+    vm = FakeVm()
+    selector = FutureSelector(vm, Disconnected)
+    both = asyncio.ensure_future(asyncio.gather(selector.wait(single(1)), selector.wait(single(2))))
+    await settle()
+    # One check, of the first of both to complete.
+    assert vm.checks == [FirstCompletedUnresolvedFuture([single(1), single(2)])]
+    vm.complete(2)
+    await settle()
+    assert not both.done()
+    vm.complete(1)
+    await both
+    assert selector.size == 0
+
+
+async def test_a_wait_made_while_the_loop_waits_for_input_joins_the_next_check():
+    vm = FakeVm()
+    selector = FutureSelector(vm, Disconnected)
+    first = asyncio.ensure_future(selector.wait(single(1)))
+    await settle()
+    assert vm.checks == [single(1)]
+    second = asyncio.ensure_future(selector.wait(single(2)))
+    await settle()
+    assert vm.wakes == 1
+    assert vm.checks[-1] == FirstCompletedUnresolvedFuture([single(1), single(2)])
+    # A third wait while the loop waits again wakes it once more, not once per wait.
+    third = asyncio.ensure_future(selector.wait(single(3)))
+    await settle()
+    assert vm.wakes == 2
+    for handle in (3, 2, 1):
+        vm.complete(handle)
+    await asyncio.gather(first, second, third)
+
+
+async def test_combinators_wait_for_their_children():
+    vm = FakeVm()
+    selector = FutureSelector(vm, Disconnected)
+    every = asyncio.ensure_future(selector.wait(AllCompletedUnresolvedFuture([single(1), single(2)])))
+    vm.complete(1)
+    await settle()
+    assert not every.done()
+    vm.complete(2)
+    await every
+
+
+async def test_a_cancellation_reaches_every_pending_wait_and_only_those():
+    vm = FakeVm()
+    selector = FutureSelector(vm, Disconnected)
+    waits = [asyncio.ensure_future(selector.wait(single(h))) for h in (1, 2)]
+    await settle()
+    vm.script.append(DoProgressCancelSignalReceived())
+    vm.complete(9)
+    for wait in waits:
+        with pytest.raises(TerminalError) as error:
+            await wait
+        assert error.value.status_code == 409
+    # What waits after it is not cancelled.
+    later = asyncio.ensure_future(selector.wait(single(3)))
+    vm.complete(3)
+    await later
+
+
+async def test_a_suspension_ends_every_wait_now_and_later():
+    vm = FakeVm()
+    selector = FutureSelector(vm, Disconnected)
+    vm.script.append(Suspended())
+    with pytest.raises(SuspendedException):
+        await selector.wait(single(1))
+    assert isinstance(selector.ended, SuspendedException)
+    assert vm.ended == 1
+    with pytest.raises(SuspendedException):
+        await selector.wait(single(2))
+
+
+async def test_an_error_of_the_vm_ends_the_attempt():
+    vm = FakeVm()
+    selector = FutureSelector(vm, Disconnected)
+    vm.script.append(ValueError("journal mismatch"))
+    with pytest.raises(SdkInternalException) as error:
+        await selector.wait(single(1))
+    assert isinstance(error.value.__cause__, ValueError)
+
+
+async def test_a_disconnect_ends_the_attempt():
+    vm = FakeVm()
+    selector = FutureSelector(vm, Disconnected)
+    wait = asyncio.ensure_future(selector.wait(single(1)))
+    await settle()
+    vm.input.put_nowait({"type": "http.disconnect"})
+    with pytest.raises(Disconnected):
+        await wait
+
+
+async def test_a_run_is_started_and_its_completion_wakes_the_loop():
+    vm = FakeVm()
+    selector = FutureSelector(vm, Disconnected)
+    vm.script.append(DoProgressExecuteRun(7))
+    await selector.wait(single(7))
+    assert vm.runs == [7]
+
+
+async def test_the_loop_stops_when_nothing_is_pending_and_starts_again():
+    vm = FakeVm()
+    selector = FutureSelector(vm, Disconnected)
+    first = asyncio.ensure_future(selector.wait(single(1)))
+    vm.complete(1)
+    await first
+    await settle()
+    assert all(task.done() for task in vm.tasks)
+    second = asyncio.ensure_future(selector.wait(single(2)))
+    vm.complete(2)
+    await second
+    assert len(vm.tasks) == 2
