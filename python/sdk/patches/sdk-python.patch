+
+    async def _start(self) -> Any:
+        host = self._host
+        if host.sql_handler_kind != "exclusive":
+            raise TerminalError("ctx.db is for exclusive object handlers")
+        if host.sql_journal_replay:
+            raise TerminalError(
+                "ctx.db needs the object's options to include restate.sql_options "
+                "(journal_replay=False): a replayed journal would not match the reads of a later attempt"
+            )
