+    @asynccontextmanager
+    async def transaction(self) -> AsyncIterator[SqlTransaction]:
+        """
+        ``ctx.transaction()``: one transaction of the session, whose sends are
+        made once it commits, and kept in the outbox until they are stored.
+        """
+        db = await self.open()
