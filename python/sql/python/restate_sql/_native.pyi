# The native extension (src/lib.rs); see __init__.py for the API.
from collections.abc import Awaitable, Callable
from typing import Any

GET: int
SET: int
CLEAR: int
SYNC: int

class Database:
    def query(self, sql: str, params: Any | None = None) -> Awaitable[list[list[Any]]]: ...
    def query_columns(self, sql: str, params: Any | None = None) -> Awaitable[tuple[list[str], list[list[Any]]]]: ...
    def begin(self) -> Awaitable[None]: ...
    def commit(self, effects: bytes | None = None) -> Awaitable[None]: ...
    def rollback(self) -> Awaitable[None]: ...
    def is_usable(self) -> bool: ...
    def effects(self) -> Awaitable[bytes]: ...
    def save(self) -> Awaitable[None]: ...
    def close(self) -> Awaitable[None]: ...

def open(
    namespace: str, dispatch: Callable[..., None], event_loop: Any, reader: bool = False
) -> Awaitable[Database]: ...
